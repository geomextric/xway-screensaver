#!/usr/bin/env python3
"""Launcher: finds the xway_screensaver package next to this script's real location."""
import os
import sys

root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.isdir(os.path.join(root, "xway_screensaver")):
    sys.path.insert(0, root)

from xway_screensaver.cli import main  # noqa: E402

sys.exit(main())
